<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta http-equiv="x-ua-compatible" content="ie=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

  <title>RubyConf AU 2027</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bree+Serif&family=Noto+Sans:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
  <style>
    :root {
      background: #1e1e1e;
      height: 100%;
      width: 100%;
    }

    @property --gradient-start {
      syntax: "<color>";
      initial-value: #ee7752;
      inherits: false;
    }

    @property --gradient-end {
      syntax: "<color>";
      initial-value: #e73c7e;
      inherits: false;
    }

    body {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      width: 100%;
      height: 100%;
      color: white;
      text-align: center;
    }

    section {
      aspect-ratio: 100 / 82;
      width: 100%;
      max-width: 10rem;
      mask: url('data:image/svg+xml,<svg width="100%" height="100%" viewBox="0 0 100 82" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" xml:space="preserve" xmlns:serif="http://www.serif.com/" style="fill-rule:evenodd;clip-rule:evenodd;stroke-linejoin:round;stroke-miterlimit:2;"><g transform="matrix(0.095238,-1.4585e-16,-1.4585e-16,-0.095238,-12.2243,127.655)"><g><path d="M318,1334C276,1316 117,1056 129,1025C145,984 177,1007 241,1107C277,1161 312,1211 321,1218C339,1234 339,1233 366,1111L386,1019L324,1012C290,1008 263,1001 263,997C263,992 292,987 327,985L392,982L491,788L589,593L504,677C457,723 378,807 329,863C279,920 230,968 218,972C194,980 168,960 168,932C168,887 578,483 624,483C636,483 658,491 672,501C732,541 907,701 1037,833C1143,940 1176,981 1176,1001C1176,1041 1053,1276 1017,1307C985,1333 985,1334 757,1334C631,1334 486,1336 435,1339C383,1342 331,1340 318,1334ZM536,1186C493,1146 455,1113 452,1113C448,1113 431,1143 412,1181C373,1261 368,1257 515,1258L614,1259L536,1186ZM1001,1226C1015,1207 1044,1157 1065,1116L1103,1040L1003,1040C891,1040 892,1039 919,1113C947,1192 936,1207 901,1139C884,1105 867,1074 865,1072C859,1066 683,1241 683,1252C683,1256 748,1260 829,1260L975,1260L1001,1226ZM830,1039C830,1032 483,1015 477,1021C475,1023 511,1071 558,1128L644,1230L737,1138C788,1087 830,1042 830,1039ZM816,962C819,959 780,878 731,781L642,604L627,641C539,851 494,964 494,971C494,979 808,970 816,962ZM1028,957L1074,950L959,840C828,714 710,609 700,609C696,609 733,689 782,788L872,966L927,965C957,965 1003,961 1028,957Z" style="fill-rule:nonzero;"/></g></g></svg>');
      mask-repeat: no-repeat;
    }

    .logo {
      background: linear-gradient(
        135deg,
        var(--gradient-start),
        var(--gradient-end)
      );
      animation: gradient-colors 10s ease infinite;
    }

    @keyframes gradient-colors {
      0%, 100% {
        --gradient-start: #ee7752;
        --gradient-end: #e73c7e;
      }
      33% {
        --gradient-start: #23a6d5;
        --gradient-end: #23d5ab;
      }
      66% {
        --gradient-start: #667eea;
        --gradient-end: #764ba2;
      }
    }

    h1 {
      font-family: "Bree Serif", serif;
      font-weight: 400;
      font-style: normal;
      font-size: 3rem;
    }

    h2 {
      font-family: "Bree Serif", serif;
      font-weight: 400;
      font-style: normal;
      font-size: 2rem;
    }

    p {
      font-family: "Noto Sans", sans-serif;
      font-optical-sizing: auto;
      font-weight: 400;
      font-style: normal;
      font-variation-settings: "wdth" 100;
      font-size: 1.5rem;
      line-height: 1.5;
    }

    content {
      margin: 0 3rem;
      max-width: 35rem;
    }

    a {
      color: white;
    }
  </style>
</head>
<body>
  <div>
    <h2><a href="https://ti.to/ruby-australia/rubyconf-au-2027" target="_blank">Buy your ticket now!</a></h2>
  </div>
  <section class="logo">
  </section>
  <h1>RubyConf AU 2027</h1>
  <h2>
    18th-19th March 2027
    <br>
    The Rendezvous Hotel
    <br>
    Narrm / Melbourne CBD
  </h2>
  <content>
    <p>
      Sharing wisdom and joy from Rubyists to the world.
      Early-bird tickets are <a href="https://ti.to/ruby-australia/rubyconf-au-2027" target="_blank">now available</a>, and the <a href="https://sessionize.com/rubyconf-au-2027/" target="_blank">call for proposals</a> is open.
      Speakers and more details are coming soon!
    </p>
    <p>
      <a href="https://confirmsubscription.com/h/j/809D057CE90261E7" target="_blank">Join our mailing list</a>
      <br>
      <a href="https://ruby.org.au/code-of-conduct" target="_blank">Code of Conduct</a>
      <br>
      <a href="https://www.ruby.org.au" target="_blank">Ruby Australia</a>
    </p>
  </content>
</body>
</html>
